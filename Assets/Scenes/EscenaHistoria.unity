      m_Calls: []
  m_text: "Adivinad que\u2026 \xA1Hoy es mi primer d\xEDa de curro! Soy un monstruo
    bastante afortunado, no toda la cementariada ha logrado trabajar en el lugar
    de sus pesadillas."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: b7935f711fd2d564380ac6fa8b855a2a, type: 2}
